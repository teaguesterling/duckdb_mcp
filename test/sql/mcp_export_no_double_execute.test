# name: test/sql/mcp_export_no_double_execute.test
# description: Verify export tool does not run query more times than necessary (issue #37)
# group: [sql]

require duckdb_mcp

require notwindows

statement ok
LOAD duckdb_mcp;

# Force clean state
statement ok
SELECT mcp_server_stop(true);

# Start server with memory transport and file export enabled
query I
SELECT mcp_server_start('memory', '{"export_allow_file_output": true}');
----
{'success': true, 'running': true, 'message': 'MCP server started on memory transport (background mode)', 'transport': memory, 'listen': localhost, 'port': 0, 'background': true, 'requests_received': 0, 'responses_sent': 0, 'errors_returned': 0}

# Initialize handshake
statement ok
SELECT mcp_server_send_request('{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"test","version":"0.1"}}}');

# =============================================================================
# TEST 1: File export does not execute the query more than needed
# =============================================================================
# The property under test: the export tool runs the user's query exactly once
# per tool call and adds no executions of its own. The original bug (issue #37)
# ran it 4 times.
#
# We do NOT pin DuckDB's own evaluation count, because it is not ours and it
# changes. `mcp_server_send_request(<literal>)` is a foldable call, and here it
# sits inside another function (LIKE). On DuckDB v1.5.6 such an argument is
# evaluated twice: once by the function binder, which folds foldable arguments
# only to test them for NULL and then discards the value, and once more by the
# optimizer's constant folding. DuckDB PR #26795 ("Fold constant function
# arguments while binding", on v2.0-cyanoptera since 2026-10-12) keeps the
# folded value instead of discarding it, so the optimizer has nothing left to
# evaluate and the count drops to one. The old assertion hard-coded the v1.5
# number 3 and went red on the 2.0 line with 2 - a true statement about DuckDB's
# binder, and nothing about our export tool.
#
# So measure the export against an in-run control in the identical statement
# shape: the `query` tool, which also runs its SQL exactly once per call.
# Whatever multiplier the engine applies to the enclosing statement applies to
# both tools equally, so it cancels, and only an extra execution of mcp's own
# makes the two sequences diverge. Equal advance means the export added nothing.

statement ok
CREATE SEQUENCE control_seq START 1;

statement ok
CREATE SEQUENCE export_seq START 1;

# Control: one tool call that runs its SQL exactly once.
query I
SELECT mcp_server_send_request('{"jsonrpc":"2.0","id":9,"method":"tools/call","params":{"name":"query","arguments":{"sql":"SELECT nextval(''control_seq'') as val"}}}') LIKE '%val%';
----
true

# File export of a query over its own sequence, in the same statement shape.
query I
SELECT mcp_server_send_request('{"jsonrpc":"2.0","id":10,"method":"tools/call","params":{"name":"export","arguments":{"query":"SELECT nextval(''export_seq'') as val","format":"csv","output":"__TEST_DIR__/mcp_test_double_exec.csv"}}}') LIKE '%Data exported%';
----
true

# Both sequences advanced equally: the export added no executions. With the
# original 4x bug the export side advances 4 values per control value, so this
# comparison is false.
query I
SELECT nextval('control_seq') = nextval('export_seq');
----
true

statement ok
DROP SEQUENCE control_seq;

statement ok
DROP SEQUENCE export_seq;

# =============================================================================
# TEST 2: Inline return works correctly
# =============================================================================

query I
SELECT mcp_server_send_request('{"jsonrpc":"2.0","id":20,"method":"tools/call","params":{"name":"export","arguments":{"query":"SELECT 42 as answer","format":"csv"}}}') LIKE '%42%';
----
true

# =============================================================================
# TEST 3: File export produces correct data
# =============================================================================

query I
SELECT mcp_server_send_request('{"jsonrpc":"2.0","id":30,"method":"tools/call","params":{"name":"export","arguments":{"query":"SELECT 100 as num, ''hello'' as txt","format":"csv","output":"__TEST_DIR__/mcp_test_export_data.csv"}}}') LIKE '%Data exported%';
----
true

# Verify the file content by reading it back
query II
SELECT * FROM read_csv('__TEST_DIR__/mcp_test_export_data.csv');
----
100	hello

# =============================================================================
# TEST 4: Error propagation from COPY
# =============================================================================

# Exporting to a non-writable path should return an error message (not generic "Failed to export")
query I
SELECT mcp_server_send_request('{"jsonrpc":"2.0","id":40,"method":"tools/call","params":{"name":"export","arguments":{"query":"SELECT 1","format":"csv","output":"__TEST_DIR__/nonexistent_subdir/test.csv"}}}') LIKE '%error%';
----
true

# Verify it's NOT the old generic error message
query I
SELECT mcp_server_send_request('{"jsonrpc":"2.0","id":41,"method":"tools/call","params":{"name":"export","arguments":{"query":"SELECT 1","format":"csv","output":"__TEST_DIR__/nonexistent_subdir/test.csv"}}}') NOT LIKE '%Failed to export to file%';
----
true

# =============================================================================
# TEST 5: File and inline paths consume the same number of sequence values
# =============================================================================
# Both paths should use conn.Query() exactly once, consuming the same number of values.

statement ok
CREATE SEQUENCE inline_seq START 1;

statement ok
CREATE SEQUENCE file_seq START 1;

# Inline export
query I
SELECT mcp_server_send_request('{"jsonrpc":"2.0","id":50,"method":"tools/call","params":{"name":"export","arguments":{"query":"SELECT nextval(''inline_seq'') as val","format":"csv"}}}') LIKE '%val%';
----
true

# File export
query I
SELECT mcp_server_send_request('{"jsonrpc":"2.0","id":51,"method":"tools/call","params":{"name":"export","arguments":{"query":"SELECT nextval(''file_seq'') as val","format":"csv","output":"__TEST_DIR__/mcp_test_seq_parity.csv"}}}') LIKE '%Data exported%';
----
true

# Both should have consumed the same number of values
query I
SELECT nextval('inline_seq') = nextval('file_seq');
----
true

statement ok
DROP SEQUENCE inline_seq;

statement ok
DROP SEQUENCE file_seq;

# Clean up
statement ok
SELECT mcp_server_stop();
